{
  "name": "gilli-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:engine": "node -e \"require('fs').rmSync('../publish-engine',{recursive:true,force:true})\" && dotnet publish ../server/Gilli.Wasm -c Release -o ../publish-engine --nologo && node -e \"const f=require('fs');f.rmSync('public/engine',{recursive:true,force:true});f.cpSync('../publish-engine/wwwroot/_framework','public/engine/_framework',{recursive:true,filter:s=>!s.endsWith('.gz')&&!s.endsWith('.br')})\""
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@vercel/blob": "^2.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.2.4",
    "vitest": "^4.1.11"
  }
}
